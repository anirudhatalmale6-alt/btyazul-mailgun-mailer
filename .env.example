# ---------------------------------------------------------------------------
# Mailgun settings for btyazul.com
#
# COPY this file to ".env" and fill in the real values.
# Put the real ".env" OUTSIDE your public_html folder, for example:
#     /home/YOURUSER/private/.env
# so that nobody can download it from the web.
#
# Set its permissions to 600 (owner read/write only).
# ---------------------------------------------------------------------------

# Your Mailgun private API key. Starts with "key-" or is a long random string.
# Mailgun dashboard -> Settings -> API Keys -> Private API key
MAILGUN_API_KEY=

# The sending domain you added in Mailgun.
# We use a subdomain so your normal btyazul.com email keeps working untouched.
MAILGUN_DOMAIN=mg.btyazul.com

# Which Mailgun region your account is in.
#   us  -> https://api.mailgun.net       (default, most accounts)
#   eu  -> https://api.eu.mailgun.net    (only if you chose EU when signing up)
MAILGUN_REGION=us

# The Mailgun "HTTP webhook signing key", used to prove that bounce and
# complaint notifications really came from Mailgun and not from an attacker.
# Mailgun dashboard -> Settings -> Webhooks -> HTTP webhook signing key
MAILGUN_WEBHOOK_SIGNING_KEY=

# ---------------------------------------------------------------------------
# What the customer sees in their inbox
# ---------------------------------------------------------------------------

# Name shown as the sender.
MAIL_FROM_NAME=BT Yazul

# Address shown as the sender. Must be on MAILGUN_DOMAIN above.
MAIL_FROM_ADDRESS=orders@mg.btyazul.com

# Where customer replies should go. This CAN be your normal domain address.
MAIL_REPLY_TO=info@btyazul.com

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# 1 = do not actually send, just write what WOULD be sent to the log.
# Use this while testing. Set to 0 to send for real.
MAILGUN_DRY_RUN=1

# Where to write the send log. Must be writable by the web server.
# Keep this outside public_html too.
MAIL_LOG_FILE=/home/YOURUSER/private/logs/mail.log

# Where to record bounces and spam complaints reported by Mailgun.
MAIL_SUPPRESSION_LOG=/home/YOURUSER/private/logs/suppressions.log

# Your site's public address, used to build links inside the emails.
SITE_URL=https://btyazul.com
SITE_NAME=BT Yazul
